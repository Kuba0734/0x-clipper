{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0x-clipper",
  "mainBinaryName": "0x-clipper",
  "version": "0.1.0",
  "identifier": "app.zerox.clipper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "0x-clipper",
    "copyright": "© 2026 0x-clipper",
    "category": "Video",
    "shortDescription": "Ressourcenschonender Clip-Recorder",
    "longDescription": "0x-clipper hält einen Replay-Buffer im Hintergrund und speichert per Hotkey die letzten Sekunden als MP4.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "ffmpeg/bin/avcodec-63.dll": "avcodec-63.dll",
      "ffmpeg/bin/avformat-63.dll": "avformat-63.dll",
      "ffmpeg/bin/avutil-61.dll": "avutil-61.dll",
      "ffmpeg/bin/swresample-7.dll": "swresample-7.dll",
      "ffmpeg/bin/swscale-10.dll": "swscale-10.dll",
      "ffmpeg/LICENSE.txt": "licenses/FFmpeg-LGPL.txt",
      "../licenses/THIRD-PARTY.md": "licenses/THIRD-PARTY.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "0x-clipper"
      }
    }
  }
}
